<div class="event-card">
  <img
    src="{{ event.data.image }}"
    alt="{{ event.data.title }} event flyer"
    class="event-thumb"
  />
  <div class="event-info">
    <h2 class="event-title">{{ event.data.title }}</h2>
    <p class="event-date"><strong>Date:</strong> {{ event.data.dateString }}</p>
    <p class="event-time">
      <strong>Time:</strong> {{ event.data.start }} {%- if event.data.end %} – {{ event.data.end }} {%- else -%} {%- endif -%}
    </p>
    <p class="event-price"><strong>Tickets:</strong> {{ event.data.price }}</p>
    {%- if event.data.upcoming -%} {%- if event.content -%}
    <div class="event-description">{{ event.content | safe }}</div>
    {%- endif -%}
    {%- if event.data.hieventsID -%}
    <a href="#" class="event-button open-popup">
      {%- if event.data.buttonText -%} {{ event.data.buttonText }} {%- else -%}
      Buy Tickets {%- endif -%}
    </a>
    <div class="popup-overlay">
      <div class="popup-content">
        <button class="popup-close">✕</button>
        <div
          data-hievents-id="{{ event.data.hieventsID }}"
          data-hievents-primary-color="#e63946"
          data-hievents-primary-text-color="#ffffff"
          data-hievents-secondary-color="#e63946"
          data-hievents-secondary-text-color="#ffffff"
          data-hievents-background-color="#1f1f1f"
          data-hievents-widget-type="widget"
          data-hievents-widget-version="1.0"
          data-hievents-locale="en"
          data-hievents-padding="20px"
          data-hievents-autoresize="true"
          {%- if event.data.hieventsID == 1 -%}
          data-hievents-continue-button-text="DO, AND BY DOING, SEE"
          {%- else -%}
          data-hievents-continue-button-text="CONTINUE"
          {%- endif -%}
          class="hievents-widget"
        ></div>
      </div>
    </div>
    {%- endif -%}
    {%- endif -%}
  </div>
</div>
