---
layout: layouts/main.njk
title: upcoming events @ COLLAPSE
description: A SINGLE VOICE WILL SOON RAISE THE CLAMOR OF BEING.
---
{%- block headScripts -%}
<script async src="https://tix.collapsepgh.com/widget.js"></script>
{%- endblock -%}

<h1>Upcoming Events</h1>

{%- if collections.upcomingevents | length > 0 -%}
  {%- for event in collections.upcomingevents -%}
    {%- include "event-card.njk" -%}
  {%- endfor -%}
{%- else -%}
  <p>None yet announced... stay tuned.</p>
{%- endif -%}

{%- block bodyScripts -%}
<script src="/assets/popup.js" defer></script>
<script>
document.querySelectorAll('.event-description-wrap').forEach((wrap) => {
  const desc = wrap.querySelector('.event-description');
  const btn = wrap.querySelector('.event-description-toggle');

  // only bother if content is actually taller than the collapsed max-height
  if (desc.scrollHeight > desc.clientHeight + 4) {
    btn.style.display = 'inline-block';
    btn.addEventListener('click', () => {
      const expanded = wrap.classList.toggle('expanded');
      btn.textContent = expanded ? 'Show less' : 'Show more';
    });
  }
});
</script>
{%- endblock -%}